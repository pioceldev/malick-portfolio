# ---------------------------------------------------------------------------
# Modèle de configuration — NE PAS mettre de vraies clés dans ce fichier.
#   1. copier  :  cp .env.example .env
#   2. remplir les valeurs dans .env (ce fichier est ignoré par git)
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# URL publique du site (SEO, sitemap, liens absolus)
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Base de données MySQL (WAMP / MariaDB / MySQL 8)
# Créer la base n'est pas nécessaire : elle est créée au premier démarrage.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=malick_portfolio

# Ancienne base SQLite — uniquement lue par `npm run migrate` (import unique)
DATABASE_PATH=data/portfolio.db

# ---------------------------------------------------------------------------
# E-mail transactionnel — Brevo (https://app.brevo.com)
# Seules ces valeurs sont à remplacer : le code n'a rien d'autre à modifier.
# ---------------------------------------------------------------------------

# Clé API v3 : Brevo → SMTP & API → API Keys → Generate a new API key
BREVO_API_KEY=

# Expéditeur : doit être validé dans Brevo (Senders & IP → Add a sender)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Portfolio Malick

# Adresse qui reçoit les messages du formulaire
# (si vide : malickabdou54@gmail.com)
MAIL_TO_EMAIL=
