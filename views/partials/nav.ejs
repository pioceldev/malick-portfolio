<header class="nav" id="nav">
  <a class="nav__brand" href="/" aria-label="<%= settings.display_name %> — accueil">
    <span class="nav__mark" aria-hidden="true"><%= (settings.display_name || 'M').charAt(0).toUpperCase() %></span>
    <span class="nav__name"><%= settings.display_name %></span>
  </a>

  <nav class="nav__links" aria-label="Navigation principale">
    <% nav.forEach(item => { %>
      <a class="nav__link" href="<%= item.href %>"><span><%= item.label %></span></a>
    <% }) %>
  </nav>

  <div class="nav__actions">
    <% if (cv) { %>
      <a class="btn btn--ghost nav__cv" href="<%= imageUrl(cv) %>" download>
        <span>CV</span>
      </a>
    <% } %>
    <a class="btn btn--solid nav__cta" href="#contact" data-magnetic>
      <span>Me contacter</span>
    </a>
    <button class="nav__burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <nav aria-label="Navigation mobile">
    <% nav.forEach((item, index) => { %>
      <a class="mobile-menu__link" href="<%= item.href %>" style="--i:<%= index %>">
        <span class="mobile-menu__num">0<%= index + 1 %></span>
        <span><%= item.label %></span>
      </a>
    <% }) %>
  </nav>
  <div class="mobile-menu__foot">
    <% if (settings.email) { %><a href="mailto:<%= settings.email %>"><%= settings.email %></a><% } %>
    <div class="mobile-menu__socials">
      <% socials.forEach(social => { %>
        <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer"><%= social.label %></a>
      <% }) %>
    </div>
  </div>
</div>
