<%- include('shell-start', { title }) %>

<% if (error) { %><div class="alert alert--error" role="alert"><%= error %></div><% } %>

<form class="admin-form form-grid" method="post"
      action="<%= isNew ? '/admin/' + entityKey : '/admin/' + entityKey + '/' + values.id %>"
      enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <div class="form-grid__main">
    <% entity.fields.forEach(field => { %>
      <% const value = values[field.name] === undefined || values[field.name] === null ? '' : values[field.name]; %>

      <% if (field.type === 'boolean') { %>
        <label class="switch">
          <input type="checkbox" name="<%= field.name %>" value="1" <%= value ? 'checked' : '' %>>
          <span class="switch__track"><span></span></span>
          <span class="switch__label"><%= field.label %></span>
        </label>

      <% } else if (field.type === 'select') { %>
        <label class="field">
          <span><%= field.label %><%= field.required ? ' *' : '' %></span>
          <select name="<%= field.name %>">
            <% (field.options || []).forEach(option => { %>
              <option value="<%= option %>" <%= String(value) === String(option) ? 'selected' : '' %>><%= option %></option>
            <% }) %>
          </select>
          <% if (field.hint) { %><small class="hint"><%= field.hint %></small><% } %>
        </label>

      <% } else if (field.type === 'textarea') { %>
        <label class="field">
          <span><%= field.label %><%= field.required ? ' *' : '' %></span>
          <textarea name="<%= field.name %>" rows="<%= field.rows || 5 %>" <%= field.required ? 'required' : '' %>><%= value %></textarea>
          <% if (field.hint) { %><small class="hint"><%= field.hint %></small><% } %>
        </label>

      <% } else if (field.type === 'image' || field.type === 'file') { %>
        <div class="field">
          <span><%= field.label %></span>
          <div class="media-input">
            <div class="media-input__preview" data-preview-for="<%= field.name %>">
              <% if (value) { %>
                <% if (field.type === 'image') { %>
                  <img src="<%= imageUrl(value) %>" alt="">
                <% } else { %>
                  <span class="file-chip"><%= value %></span>
                <% } %>
              <% } else { %>
                <span class="muted">Aucun fichier</span>
              <% } %>
            </div>
            <input type="hidden" name="<%= field.name %>" value="<%= value %>" data-media-value="<%= field.name %>">
            <div class="media-input__actions">
              <button class="btn btn--tiny" type="button" data-open-media="<%= field.name %>">Médiathèque</button>
              <label class="btn btn--tiny file-label">
                Téléverser
                <input type="file" name="upload__<%= field.name %>" accept="<%= field.type === 'image' ? 'image/*' : 'image/*,application/pdf' %>">
              </label>
              <button class="btn btn--tiny btn--danger" type="button" data-clear-media="<%= field.name %>">Retirer</button>
            </div>
          </div>
          <% if (field.hint) { %><small class="hint"><%= field.hint %></small><% } %>
        </div>

      <% } else if (field.type === 'gallery') { %>
        <% let galleryItems = []; try { galleryItems = JSON.parse(value || '[]'); } catch (e) { galleryItems = []; } %>
        <div class="field" data-gallery-root>
          <span><%= field.label %></span>
          <input type="hidden" name="gallery_json" value="<%= JSON.stringify(galleryItems) %>" data-gallery-json>
          <ul class="gallery-input" data-gallery-list>
            <% galleryItems.forEach(file => { %>
              <li data-file="<%= file %>">
                <img src="<%= imageUrl(file) %>" alt="">
                <button type="button" class="gallery-input__remove" data-gallery-remove aria-label="Retirer">✕</button>
              </li>
            <% }) %>
          </ul>
          <div class="media-input__actions">
            <button class="btn btn--tiny" type="button" data-open-media-gallery>Ajouter depuis la médiathèque</button>
            <label class="btn btn--tiny file-label">
              Téléverser
              <input type="file" name="gallery_files" accept="image/*" multiple>
            </label>
          </div>
          <small class="hint">La première image sert de couverture secondaire dans la galerie du projet.</small>
        </div>

      <% } else { %>
        <label class="field">
          <span><%= field.label %><%= field.required ? ' *' : '' %></span>
          <input type="<%= field.type === 'number' ? 'number' : field.type === 'url' ? 'url' : field.type === 'email' ? 'email' : field.type === 'tel' ? 'tel' : 'text' %>"
                 name="<%= field.name %>"
                 value="<%= value %>"
                 <%= field.type === 'number' ? `min="${field.min ?? 0}" max="${field.max ?? 9999}"` : '' %>
                 <%= field.slugFrom ? `data-slug-target="${field.slugFrom}"` : '' %>
                 <%= field.required ? 'required' : '' %>>
          <% if (field.hint) { %><small class="hint"><%= field.hint %></small><% } %>
        </label>
      <% } %>
    <% }) %>
  </div>

  <aside class="form-grid__side">
    <div class="panel">
      <h2 class="panel__title">Publication</h2>
      <p class="muted"><%= values.published ? 'Cet élément est visible sur le site.' : 'Brouillon : invisible pour les visiteurs.' %></p>
      <button class="btn btn--primary btn--block" type="submit">Enregistrer</button>
      <a class="btn btn--ghost btn--block" href="/admin/<%= entityKey %>">Annuler</a>
      <% if (entityKey === 'projects' && !isNew) { %>
        <a class="btn btn--ghost btn--block" href="/admin/preview/project/<%= values.id %>" target="_blank" rel="noopener">Prévisualiser</a>
      <% } %>
    </div>

    <div class="panel panel--help">
      <h2 class="panel__title">Bon à savoir</h2>
      <ul class="help-list">
        <li>Les sections vides sont masquées automatiquement sur le site public.</li>
        <li>Une ligne vide dans un texte crée un nouveau paragraphe.</li>
        <li>Les images sont optimisées via la médiathèque.</li>
      </ul>
    </div>
  </aside>
</form>

<%- include('shell-end') %>
