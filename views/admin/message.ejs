<%- include('shell-start', { title: 'Message de ' + message.name }) %>

<a class="link" href="/admin/messages">← Retour à la boîte de réception</a>

<article class="panel message">
  <header class="message__head">
    <div>
      <h2 class="message__subject"><%= message.subject || 'Sans sujet' %></h2>
      <p class="muted">
        De <strong><%= message.name %></strong> ·
        <a href="mailto:<%= message.email %>"><%= message.email %></a>
        <% if (message.project_type) { %> · <%= message.project_type %><% } %>
        <% if (message.budget) { %> · Budget : <%= message.budget %><% } %>
      </p>
      <p class="muted">Reçu le <%= String(message.created_at).replace('T', ' ').slice(0, 16) %></p>
    </div>
    <div class="row-actions">
      <a class="btn btn--primary btn--tiny" href="mailto:<%= message.email %>?subject=<%= encodeURIComponent('Re: ' + (message.subject || 'Votre message')) %>">Répondre</a>
      <form method="post" action="/admin/messages/<%= message.id %>/<%= message.archived ? 'restore' : 'archive' %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="back" value="/admin/messages/<%= message.id %>">
        <button class="btn btn--tiny" type="submit"><%= message.archived ? 'Restaurer' : 'Archiver' %></button>
      </form>
      <form method="post" action="/admin/messages/<%= message.id %>/delete" data-confirm="Supprimer ce message ?">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="back" value="/admin/messages">
        <button class="btn btn--tiny btn--danger" type="submit">Supprimer</button>
      </form>
    </div>
  </header>

  <div class="message__body">
    <%- paragraphs(message.body) %>
  </div>
</article>

<%- include('shell-end') %>
