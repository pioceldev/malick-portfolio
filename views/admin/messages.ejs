<%- include('shell-start', { title }) %>

<div class="toolbar">
  <div class="tabs">
    <a href="/admin/messages" class="<%= !showArchived ? 'is-active' : '' %>">Boîte de réception</a>
    <a href="/admin/messages?archive=1" class="<%= showArchived ? 'is-active' : '' %>">Archivés</a>
  </div>
  <p class="toolbar__count"><%= messages.length %> message(s)</p>
</div>

<section class="panel panel--flush">
  <% if (messages.length === 0) { %>
    <div class="empty">
      <p class="empty__title">Aucun message</p>
      <p class="muted">Les messages envoyés depuis le formulaire de contact apparaîtront ici.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Expéditeur</th>
            <th>Sujet</th>
            <th>Type</th>
            <th>Reçu le</th>
            <th class="cell-actions">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% messages.forEach(message => { %>
            <tr class="<%= message.is_read ? '' : 'is-unread' %>">
              <td>
                <a class="link-strong" href="/admin/messages/<%= message.id %>"><%= message.name %></a>
                <small class="muted block"><%= message.email %></small>
              </td>
              <td>
                <a href="/admin/messages/<%= message.id %>"><%= message.subject || 'Sans sujet' %></a>
                <% if (!message.is_read) { %><span class="pill pill--new">Nouveau</span><% } %>
              </td>
              <td><%= message.project_type || '—' %></td>
              <td><%= String(message.created_at).slice(0, 16) %></td>
              <td class="cell-actions">
                <div class="row-actions">
                  <a class="btn btn--tiny" href="/admin/messages/<%= message.id %>">Lire</a>
                  <form method="post" action="/admin/messages/<%= message.id %>/<%= message.archived ? 'restore' : 'archive' %>">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <input type="hidden" name="back" value="<%= showArchived ? '/admin/messages?archive=1' : '/admin/messages' %>">
                    <button class="btn btn--tiny" type="submit"><%= message.archived ? 'Restaurer' : 'Archiver' %></button>
                  </form>
                  <form method="post" action="/admin/messages/<%= message.id %>/delete" data-confirm="Supprimer ce message ?">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <input type="hidden" name="back" value="<%= showArchived ? '/admin/messages?archive=1' : '/admin/messages' %>">
                    <button class="btn btn--tiny btn--danger" type="submit">Supprimer</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('shell-end') %>
