<%- include('shell-start', { title }) %>

<% if (error) { %><div class="alert alert--error"><%= error %></div><% } %>

<section class="panel">
  <h2 class="panel__title">Importer des fichiers</h2>
  <p class="muted">Images (JPG, PNG, WebP, AVIF, SVG) et PDF — 12 Mo maximum par fichier.</p>
  <form method="post" action="/admin/media" enctype="multipart/form-data" class="upload-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="dropzone">
      <input type="file" name="files" accept="image/*,application/pdf" multiple required>
      <span class="dropzone__icon">⇪</span>
      <span class="dropzone__text">Cliquez pour choisir des fichiers</span>
      <span class="dropzone__hint" data-file-name>Aucun fichier sélectionné</span>
    </label>
    <button class="btn btn--primary" type="submit">Téléverser</button>
  </form>
</section>

<section class="panel">
  <div class="panel__head">
    <h2 class="panel__title">Bibliothèque (<%= media.length %>)</h2>
  </div>

  <% if (media.length === 0) { %>
    <div class="empty">
      <p class="empty__title">Aucun média</p>
      <p class="muted">Importez vos premières images pour les utiliser dans les projets et réglages.</p>
    </div>
  <% } else { %>
    <div class="media-grid">
      <% media.forEach(item => { %>
        <article class="media-card">
          <div class="media-card__preview">
            <% if (String(item.mime).startsWith('image/')) { %>
              <img src="/uploads/<%= item.filename %>" alt="<%= item.alt %>" loading="lazy">
            <% } else { %>
              <span class="file-chip">PDF</span>
            <% } %>
          </div>
          <div class="media-card__body">
            <p class="media-card__name" title="<%= item.original_name %>"><%= item.original_name %></p>
            <p class="media-card__meta"><%= fileSizeLabel(item.size) %> · <%= String(item.created_at).slice(0, 10) %></p>
            <form method="post" action="/admin/media/<%= item.id %>/alt" class="media-card__alt">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="text" name="alt" value="<%= item.alt %>" placeholder="Texte alternatif (accessibilité)" aria-label="Texte alternatif">
              <button class="btn btn--tiny" type="submit">OK</button>
            </form>
            <div class="media-card__actions">
              <code>/uploads/<%= item.filename %></code>
              <form method="post" action="/admin/media/<%= item.id %>/delete" data-confirm="Supprimer ce fichier ? Les pages qui l’utilisent afficheront un visuel manquant.">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="btn btn--tiny btn--danger" type="submit">Supprimer</button>
              </form>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('shell-end') %>
