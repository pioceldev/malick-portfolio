<%- include('shell-start', { title }) %>

<% if (saved) { %><div class="alert alert--ok">Compte mis à jour.</div><% } %>
<% if (error) { %><div class="alert alert--error"><%= error %></div><% } %>

<div class="two-col">
  <section class="panel">
    <h2 class="panel__title">Identifiants</h2>
    <form class="admin-form" method="post" action="/admin/account">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="field">
        <span>Nom</span>
        <input type="text" name="name" value="<%= admin.name %>" required autocomplete="name">
      </label>
      <label class="field">
        <span>Adresse e-mail</span>
        <input type="email" name="email" value="<%= admin.email %>" required autocomplete="username">
      </label>
      <label class="field">
        <span>Nouveau mot de passe (optionnel)</span>
        <input type="password" name="password" minlength="10" autocomplete="new-password" placeholder="Laisser vide pour conserver">
      </label>
      <label class="field">
        <span>Confirmer le mot de passe</span>
        <input type="password" name="confirm" minlength="10" autocomplete="new-password">
      </label>
      <button class="btn btn--primary" type="submit">Enregistrer</button>
    </form>
  </section>

  <section class="panel panel--help">
    <h2 class="panel__title">Sécurité</h2>
    <ul class="help-list">
      <li>Les mots de passe sont hachés avec scrypt et un sel aléatoire.</li>
      <li>La session expire automatiquement après 12 h.</li>
      <li>Les formulaires du back-office sont protégés par un jeton CSRF.</li>
      <li>Après un changement de mot de passe, toutes les autres sessions sont révoquées.</li>
      <li>La page de création de compte disparaît dès qu’un administrateur existe.</li>
    </ul>
    <p class="muted">En production, servez le site en HTTPS pour activer les cookies sécurisés.</p>
  </section>
</div>

<%- include('shell-end') %>
